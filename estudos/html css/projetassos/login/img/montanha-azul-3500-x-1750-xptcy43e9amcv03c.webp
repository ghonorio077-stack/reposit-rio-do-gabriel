  <script>
  (function(){
    window.wpcTrack = function(eventName, surface, ref, meta) {
      try {
        var body = JSON.stringify({event_name:eventName, surface:surface||null,
          ref:ref||null, meta:meta||null, url:location.href, referrer:document.referrer});
        if (navigator.sendBeacon) navigator.sendBeacon('/social/track', new Blob([body], {type:'application/json'}));
        else fetch('/social/track', {method:'POST', credentials:'include',
              headers:{'Content-Type':'application/json'}, body:body, keepalive:true});
        if (window.gtag) window.gtag('event', eventName, {surface: surface||'', ref: ref||''});
      } catch (e) {}
    };
  })();
  </script>

  
